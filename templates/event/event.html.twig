{% extends 'front.html.twig' %}

{% block title %}Event Name{% endblock %}

{% block content %}

<div class="main-container">
    <div class="event-description-container">
        <div class="poster-big-format">
            <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
        </div>
        <div class="event-description-card">
                <div class="description-card-name"><h2>{{ event.name }}</h2></div>
                <div class="description-card-time-location"><h2>{{ event.startDate|date('l j F Y') }}</h2></div>
                <div class="description-card-time-location"><h2>Heure {{ event.startDate|date('H:i') }} - {{ event.location.name }}</h2></div>
                <div class="description-card-organizer"><h3>Présenté par : {{ event.organisation.name }}</h3></div>
                <div class="description-card-description"><h3>Description : {{ event.description }}</h3></div>
                <div class="description-card-comment"><h3>Commentaires : {{ event.comment }}</h3></div>
                <div class="description-card-moreinfo"><h4>Thématique : {{ event.thematic.value }}</h4></div>
                <div class="description-card-moreinfo"><h4>Prix : {{ event.fee.value }}</h4></div>
                <div class="description-card-moreinfo"><h4>Public : {{ event.public.value }}</h4></div>
        </div>
    </div>
</div>
{% endblock %}
