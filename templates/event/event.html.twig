{% extends 'front.html.twig' %}

{% block title %}Event Name{% endblock %}

{% block content %}

<div class="main-container">
    <div class="event-description-container">
        <div class="poster-big-format">
            <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
        </div>
        <div class="event-description-card">
                <div class="description-card-name"><h1>{{ event.name }}</h2></div>
                <div class="description-card-time-location"><h2>{{ event.startDate|date('l j F Y - H:i') }}</h2></div>
                <div class="description-card-time-location"><h2>{{ event.location.name }} - {{ event.location.town.value }}</h2></div>
                <div class="description-card-organizer"><h3>Présenté par : {{ event.organisation.name }}</h3></div>
                <div class="description-card-description"><h3>Description : </h3><textarea class="limited-textarea">{{ event.description }}</textarea></div>
                <div class="description-card-comment"><h3>Commentaires : </h3><textarea class="limited-textarea">{{ event.comment }}</textarea></div>
                <div class="description-card-moreinfo"><h4>Thématique : {{ event.thematic.value }}</div>
                <div class="description-card-moreinfo"><h4>Prix : {{ event.fee.value }}</h4></div>
                <div class="description-card-moreinfo"><h4>Public : {{ event.public.value }}</h4></div>
        </div>
    </div>
</div>
{% endblock %}
