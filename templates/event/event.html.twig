{% extends 'front.html.twig' %}

{% block title %}Event Name{% endblock %}

{% block content %}

<div class="main-container">
    <div class="event-description-container">
        <div class="poster-big-format">
            <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
        </div>

        <div class="event-description-card">
            <div class="description-card-name"><h1>{{ event.name }}</h2></div>
            <div class="description-card-time-location"><h2>{{ event.startDate|date('l j F Y') }}</h2></div>
            <div class="description-card-time-location"><h3>{{ event.startDate|date('H:i') }} {% if event.endDate %} à {{ event.endDate|date('H:i') }} {% endif %}</h3></div>
            <div class="description-card-time-location"><h3>{{ event.location.name }} - {{ event.location.town.value }}</h3></div>
            <div class="description-card-time-location"><h4>{{ event.location.address }}</h4></div>
            <div class="description-card-organizer"><h4>Présenté par : {{ event.organisation.name }}</h4></div>
            <div class="description-card-description"><h4>Description : </h4></div>
                <label class="clamp-wrapper"><input type="checkbox" hidden id="toggle-text">
                <div class="clamp3">{{ event.description }}</div>
                </label>
            <div class="description-card-comment"><h4>Commentaires : </h4></div>
                <label class="clamp-wrapper"><input type="checkbox" hidden id="toggle-text">
                <div class="clamp3">{{ event.comment }}</div>
                </label>  
            <div class="description-card-moreinfo"><h4>{{ event.thematic.value }} - {{ event.fee.value }} - Public : {{ event.public.value }}</h4></div>
        </div>
    </div>
</div>
{% endblock %}
