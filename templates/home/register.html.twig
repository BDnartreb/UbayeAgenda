{% extends 'front.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block content %}
    <div class="container">
        <div class="row min-vh-100 align-items-center justify-content-center">
            <nav class="col-md-6 col-lg-4">
                <div class="position-sticky">
                    {{ form_start(form) }}
                        <h1 class="h3 mb-3 fw-normal">Bienvenue !</h1>
                        {{ form_errors(form) }}
                        <fieldset class="mb-3">
                            <div class="mb-3">
                            {{ form_row(form.firstName) }}
                            </div>
                            <div class="mb-3">
                            {{ form_row(form.lastName) }}
                            </div>
                            <div class="mb-3"></div>
                            {{ form_row(form.email) }}
                            </div>
                            <div class="mb-3">
                            {{ form_row(form.password) }}
                            </div>
                            <div class="mb-3">
                            {{ form_row(form.phone) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(form.organisations) }}
                            </div>
                        </fieldset>
                        <button class="btn btn-primary" type="submit">S'inscrire</button>
                    {{ form_end(form) }}
                </div>
            </nav>
        </div>
    </div>
{% endblock %}