{% extends 'front.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block content %}
    <div class="container">
        <div class="row min-vh-100 align-items-center justify-content-center">
            <nav class="col-md-6 col-lg-4">
                <div class="position-sticky">
                    {{ form_start(form) }}
                        <h1 class="h3 mb-3 fw-normal">Bienvenue !</h1>
                        {{ form_errors(form) }}
                        <fieldset class="mb-3">
                            <div class="mb-3">{{ form_row(form.name) }}</div>
                            <div class="mb-3">{{ form_row(form.address) }}</div>
                            <div class="mb-3">{{ form_row(form.town) }}</div>
                            <div class="mb-3">{{ form_row(form.email) }}</div>
                            <div class="mb-3">{{ form_row(form.phone) }}</div>
                            <div class="mb-3">{{ form_row(form.status) }}</div>
                            <div class="mb-3">{{ form_row(form.firstName) }}</div>
                            <div class="mb-3">{{ form_row(form.lastName) }}</div>
                            <div class="mb-3">{{ form_row(form.plainPassword) }}</div>

                            {% if app.user is null %}
                            <label>
                                <input type="checkbox" name="charter" required>
                                J’ai lu <a href="/charter" target="_blank">la charte d'utilisation de ce site</a> et je m'engage à la respecter.
                            </label>
                            {% endif %}

                        </fieldset>
                        <button class="btn btn-primary" type="submit">{{ buttonName }}</button>
                    {{ form_end(form) }}
                </div>
            </nav>
        </div>
    </div>
{% endblock %}