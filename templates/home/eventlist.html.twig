{% extends 'front.html.twig' %}

{% block title %}UbayeAgenda{% endblock %}

{% block content %}
    <div class="main-container">
        {% if app.user %}
            <div>
                Bienvenue {{ app.user.firstName }} !
            </div>
        {% endif %}
        <div class="left-container">Filtres</div>
        <div class="agenda-container">
            <div class="day-container">

                {% set currentDate = null %}

                {% for event in events %}
                    {% set eventDate = event.startDate|date('Y-m-d') %}

                    {% if eventDate != currentDate %}
                        <div class="day">
                            {# <div class="day-before"><h1><i class="fa-solid fa-caret-left"></i></h1></div> #}
                            <div class="day"><h1>{{ event.startDate|date('l j F Y') }}</h1></div>
                            {# <div class="day-after"><h1><i class="fa-solid fa-caret-right"></i></h1></div> #}
                        </div>                                  
                    {% endif %}

                    <div class="events">
                        <a href="{{ path('event', {'id': event.getId()}) }}">
                            <div class="event-card">
                                <div class="event-poster">
                                    <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
                                </div>
                                <div class="event-info">
                                    <div class="event-name"><h2>{{ event.name }}</h2></div>
                                    {% if event.endDate is null %}
                                    <div class="event-time-location"><h2>{{ event.startDate|date('H:i') }} - {{ event.location.name }} - {{ event.location.town.value }}</h2></div>
                                    {% else %}
                                    <div class="event-time-location"><h2>de {{ event.startDate|date('H:i') }} à {{ event.endDate|date('H:i') }} - {{ event.location.name }} - {{ event.location.town.value }}</h2></div>
                                    {% endif  %}
                                    <div class="event-organizer"><h3>Présenté par : {{ event.organisation.name }}</h3></div>
                                    <div class="event-moreinfo"><h4>{{ event.thematic.value }} - {{ event.fee.value }} - {{ event.public.value }}</h4></div>
                                </div>
                            </div>
                        
                        </a>
                    </div>

                    {% set currentDate = eventDate %}
                    
                {% endfor %}
            </div> 
        </div>
    </div>

{% endblock %}
