{% extends 'front.html.twig' %}

{% block title %}UbayeAgenda{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="filter-container">
            {% if app.user %}
                <div>Bienvenue {{ app.user.firstName }} !</div>
            {% endif %}
            <div><h1>Filtrer par :</h1></div>


           <form id="filters-form" method="get" action="{{ path('eventlist') }}">
                <div class="filter-group">
                    <input type="checkbox" id="toggle-organisateur" hidden>
                    <label for="toggle-organisateur" class="filter-title">Organisateur</label>
                    <div class="filter-options {% if selectedOrganisations is not empty %}open{% endif %}">
                        {% for organisation in organisations %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="organisations[]" 
                                    value="{{ organisation.name }}"
                                    {% if organisation.name in selectedOrganisations %}checked{% endif %}
                                >
                                {{ organisation.name }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-thematic" hidden>
                    <label for="toggle-thematic" class="filter-title">Thématique</label>
                    <div class="filter-options {% if selectedThematics is not empty %}open{% endif %}">
                        {% for thematic in thematics %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="thematics[]" 
                                    value="{{ thematic.name }}"
                                    {% if thematic.value in selectedThematics %}checked{% endif %}
                                >
                                {{ thematic.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-fee" hidden>
                    <label for="toggle-fee" class="filter-title">Prix</label>
                    <div class="filter-options {% if selectedFees is not empty %}open{% endif %}">
                        {% for fee in fees %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="fees[]" 
                                    value="{{ fee.value }}"
                                    {% if fee.value in selectedFees %}checked{% endif %}
                                >
                                {{ fee.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-public" hidden>
                    <label for="toggle-public" class="filter-title">Public</label>
                    <div class="filter-options {% if selectedPublics is not empty %}open{% endif %}">
                        {% for public in publics %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="publics[]" 
                                    value="{{ public.value }}"
                                    {% if public.value in selectedPublics %}checked{% endif %}
                                >
                                {{ public.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-town" hidden>
                    <label for="toggle-town" class="filter-title">Commune</label>
                    <div class="filter-options {% if selectedTowns is not empty %}open{% endif %}">
                        {% for town in towns %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="towns[]" 
                                    value="{{ town.value }}"
                                    {% if town.value in selectedTowns %}checked{% endif %}
                                >
                                {{ town.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-location" hidden>
                    <label for="toggle-location" class="filter-title">Lieu</label>
                    <div class="filter-options {% if selectedLocations is not empty %}open{% endif %}">
                        {% for location in locations %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="locations[]" 
                                    value="{{ location.name }}"
                                    {% if location.name in selectedLocations %}checked{% endif %}
                                >
                                {{ location.name }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>
            <button type="submit" class="btn btn-danger">Filtrer</button>
            {# <button type="button" id="reset-filters" class="btn btn-secondary">Réinitialiser</button> #}
            </form>
        </div>

       <div class="agenda-container">
            <div class="day-container">

                {% set currentDate = null %}

                {% if events is empty %}
                    <h1>{{ noEventSelectedMessage }}</h1>
                {% endif %}

                {% for event in events %}
                    {% set eventDate = event.startDate|date('Y-m-d') %}

                    {% if eventDate != currentDate %}
                        <div class="day">
                            {# <div class="day-before"><h1><i class="fa-solid fa-caret-left"></i></h1></div> #}
                            <div class="day"><h1>{{ event.startDate|date('l j F Y') }}</h1></div>
                            {# <div class="day-after"><h1><i class="fa-solid fa-caret-right"></i></h1></div> #}
                        </div>                                  
                    {% endif %}

                    <div class="events">
                        <a href="{{ path('event', {'id': event.getId()}) }}">
                            <div class="event-card">
                                <div class="event-poster">
                                    <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
                                </div>
                                <div class="event-info">
                                    <div class="event-name"><h2>{{ event.name }}</h2></div>
                                    {% if event.endDate is null %}
                                    <div class="event-time-location"><h3>{{ event.startDate|date('H:i') }} - {{ event.location.name }} - {{ event.location.town.value }}</h3></div>
                                    {% else %}
                                    <div class="event-time-location"><h3>de {{ event.startDate|date('H:i') }} à {{ event.endDate|date('H:i') }} - {{ event.location.name }} - {{ event.location.town.value }}</h3></div>
                                    {% endif  %}
                                    <div class="event-organizer"><h4>Présenté par : {{ event.organisation.name }}</h4></div>
                                    <div class="event-moreinfo"><h5>{{ event.thematic.value }} - {{ event.fee.value }} - {{ event.public.value }}</h5></div>
                                </div>
                            </div>
                        
                        </a>
                    </div>

                    {% set currentDate = eventDate %}
                    
                {% endfor %}
            </div> 
        </div>
    </div>
{% endblock %}

{% block javascripts %}
        <script src="{{ asset('js/filters.js') }}" defer></script>
{% endblock %}



