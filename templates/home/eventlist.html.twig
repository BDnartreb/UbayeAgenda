{% extends 'front.html.twig' %}

{% block title %}UbayeAgenda{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="left-container">
            {% if app.user %}
                <div><h1>Bienvenue {{ app.user.name }} !</h1></div>
            {% endif %}
            <div><h2>Filtrer par :</h2></div>

            <form id="filters-form" method="get" action="{{ path('eventlist') }}">
                <div class="filter-group">
                    <input type="checkbox" id="toggle-thematic" hidden>
                    <label for="toggle-thematic" class="filter-title">Thématique</label>
                    <div class="filter-options {% if selectedThematics is not empty %}open{% endif %}">
                        {% for thematic in thematics %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="thematics[]" 
                                    value="{{ thematic.value }}"
                                    {% if thematic.value in selectedThematics %}checked{% endif %}
                                >
                                {{ thematic.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-fee" hidden>
                    <label for="toggle-fee" class="filter-title">Prix</label>
                    <div class="filter-options {% if selectedFees is not empty %}open{% endif %}">
                        {% for fee in fees %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="fees[]" 
                                    value="{{ fee.value }}"
                                    {% if fee.value in selectedFees %}checked{% endif %}
                                >
                                {{ fee.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-public" hidden>
                    <label for="toggle-public" class="filter-title">Public</label>
                    <div class="filter-options {% if selectedPublics is not empty %}open{% endif %}">
                        {% for public in publics %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="publics[]" 
                                    value="{{ public.value }}"
                                    {% if public.value in selectedPublics %}checked{% endif %}
                                >
                                {{ public.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <input type="checkbox" id="toggle-town" hidden>
                    <label for="toggle-town" class="filter-title">Commune</label>
                    <div class="filter-options {% if selectedTowns is not empty %}open{% endif %}">
                        {% for town in towns %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="towns[]" 
                                    value="{{ town.value }}"
                                    {% if town.value in selectedTowns %}checked{% endif %}
                                >
                                {{ town.value }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div>

                {# <div class="filter-group">
                    <input type="checkbox" id="toggle-location" hidden>
                    <label for="toggle-location" class="filter-title">Lieu</label>
                    <div class="filter-options {% if selectedLocations is not empty %}open{% endif %}">
                        {% for location in locations %}
                            <label>
                                <input 
                                    type="checkbox" 
                                    name="locations[]" 
                                    value="{{ location.name }}"
                                    {% if location.name in selectedLocations %}checked{% endif %}
                                >
                                {{ location.name }}
                            </label><br>
                        {% endfor %}
                    </div>
                </div> #}

                {% set today = 'now'|date('Y-m-d') %}
                <div class="filter-group">
                    <input 
                        type="checkbox" 
                        id="toggle-date" 
                        hidden
                        {% if selectedDate != today %}checked{% endif %}
                    >

                    <label for="toggle-date" class="filter-title">Date</label>

                    <div class="filter-options">
                        <input 
                            type="date"
                            id="selectedDate"
                            name="selectedDate"
                            value="{{ selectedDate }}"
                        >
                    </div>
                </div>

             <button type="submit" class="btn btn-danger">Filtrer</button>
            {# <button type="button" id="reset-filters" class="btn btn-secondary">Réinitialiser</button> #}
            </form>
            <br>
            {# <p>Site hébergé par le Collectif Etoile de la Vallée de l'Ubaye</p>
            <p>Développé par Bertrand Barbo</p> #}
        </div>

        <div class="central-container">
            {% set currentDate = null %}

            {% if events is empty %}
                <h1>{{ noEventSelectedMessage }}</h1>
            {% endif %}

            {% for event in events %}
                {% set eventDate = event.startDate|date('Y-m-d') %}

                {% if eventDate != currentDate %}
                    <div class="date">
                        {# <div class="day-before"><h1><i class="fa-solid fa-caret-left"></i></h1></div> #}
                        {# <div class="date"><h1>{{ event.startDate|fr_date('l j F Y') }}</h1></div> #}
                        <h1>{{ event.startDate|format_datetime(pattern='EEEE d MMMM yyyy', locale='fr') }}</h1>
                        {# <div class="day-after"><h1><i class="fa-solid fa-caret-right"></i></h1></div> #}
                    </div>                                  
                {% endif %}

                <div class="event">
                    <a href="{{ path('event', {'id': event.getId()}) }}">
                        <div class="event-medium-card">
                            {% if event.poster is not empty %}
                                <div class="event-poster">
                                    <img src="{{ asset(event.poster) }}" alt="Affiche de l'événement">
                                </div>
                            {% endif %}
                            <div class="event-medium-card-data">
                                <div class=""><h2>{{ event.name }}</h2></div>
                                {% if event.endDate is null %}
                                <div class=""><h3>{{ event.startDate|date('H:i') }} -  {{ event.location.name }} - {{ event.location.town.value }}</h3></div>
                                {% else %}
                                <div class=""><h3>de {{ event.startDate|date('H:i') }} à {{ event.endDate|date('H:i') }} - {{ event.location.name }} - {{ event.location.town.value }}</h3></div>
                                {% endif  %}
                                <div class=""><h4>Présenté par : {{ event.organisation.name }}</h4></div>
                                <div class=""><h5>{{ event.thematic.value }} - {{ event.fee.value }} - Public : {{ event.public.value }}</h5></div>
                            </div>
                        </div>
                    </a>
                </div>

                {% set currentDate = eventDate %}
                
            {% endfor %}
        </div> 
    </div>
{% endblock %}

{% block javascripts %}
        <script src="{{ asset('js/filters.js') }}" defer></script>
{% endblock %}



