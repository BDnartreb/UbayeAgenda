{% extends 'admin.html.twig' %}

{% block title %}Organisations{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="left-container">Filtres</div>
        <div class="agenda-container">
            <div class="day-container">
                {% for organisation in organisations %}
                <div class="day">
                    <div class="orga_name"><h1> {{ organisation.name }} </h1></div>
                    <a href="{{ path('admin_organisation_update', {'id': organisation.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('admin_organisation_delete', {'id': organisation.id}) }}" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette organisation ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ organisation.id) }}">
                        <button type="submit" class="btn-link">Supprimer</button>
                    </form>
                </div>
                {% endfor %}
            </div> 
        </div>
    </div>

{% endblock %}
