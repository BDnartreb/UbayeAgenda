{% extends 'admin.html.twig' %}

{% block title %}UbayeAgenda{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="left-container">Filtres</div>
        <div class="agenda-container">
            <div class="day-container">
                {% for event in events %}
                <div class="day">
                    <div class="event_name"><h1> {{ event.name }} </h1></div>
                    <a href="{{ path('event', {'id': event.id}) }}">Voir</a>
                    <a href="{{ path('admin_event_update', {'id': event.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('admin_event_delete', {'id': event.id}) }}" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette organisation ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                        <button type="submit" class="btn-link">Supprimer</button>
                    </form>
                </div>
                {% endfor %}
                <div class="events">
                    <div class="event-card">
                        <div class="event-poster">
                            <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
                        </div>
                        <div class="event-info">
                            <div class="event-time-location"><h2>11h30 - Lieu de l'Event</h2></div>
                            <div class="event-name"><h2>Event Name</h2></div>
                            <div class="event-organizer"><h3>Présenté par : Organisateur Name</h3></div>
                            <div class="event-moreinfo"><h4>Spectacle - Gratuit - Tout public</h4></div>
                        </div>
                    </div>
                </div>
            </div> 
        </div>
    </div>

{% endblock %}
