{% extends 'front.html.twig' %}

{% block title %}UbayeAgenda{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="central-container">
        <div id='calendar'>

        </div>
        </div> 
    </div>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('js/filters.js') }}" defer></script>

  <script>
    function initCalendar() {
      const calendarEl = document.getElementById('calendar');
      if (!calendarEl) return; // sécurité
     
      const eventsData = JSON.parse(`{{ events|json_encode|raw }}`);
     
      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',

        firstDay: 1,

        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth timeGridWeek'
        },

        events: eventsData,

        buttonText: {
          today: 'Aujourd\'hui',
          dayGridMonth: 'Mois',
          dayGridWeek: 'Semaine',
        },

        nowIndicator: true,

        // display specific field (organisation)
        // eventDidMount: function(info) {
        //     const organisation = info.event.extendedProps.organisation;
        //     const location = info.event.extendedProps.location;
        //     if (organisation) {
        //         info.el.setAttribute('title', `Organisation : ${organisation}`, `Lieu : ${location}`);
        //     }
        // }
        eventDidMount: function(info) {
    const organisation = info.event.extendedProps.organisation;
    const location = info.event.extendedProps.location;
    const town = info.event.extendedProps.town;
    // Crée le texte du tooltip
    let tooltipText = '';
    if (organisation) {
        tooltipText += `${organisation}`;
    }
    if (location) {
        if (tooltipText !== '') tooltipText += '\n'; // saut de ligne
        tooltipText += `${location}`;
    }
    if (town) {
        if (tooltipText !== '') tooltipText += '\n'; // saut de ligne
        tooltipText += `${town}`;
    }

    // Ajoute le tooltip
    if (tooltipText !== '') {
        info.el.setAttribute('title', tooltipText);
    }
}
        
      });
      
      calendar.render();
    }

    initCalendar();

  </script>
{% endblock %}



