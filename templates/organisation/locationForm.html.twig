{% extends 'front.html.twig' %}

{% block title %}Créer un lieu{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="standard-container">
            {{ form_start(form) }}
                <h1 class="h3 mb-3 fw-normal">Créer un lieu</h1>
                {{ form_errors(form) }}
                <fieldset class="mb-3">
                    <div class="mb-3">{{ form_row(form.name) }}</div>
                    <div class="mb-3">{{ form_row(form.address) }}</div>
                    <div class="mb-3">{{ form_row(form.town) }}</div>
                    <div class="mb-3">{{ form_row(form.lat) }}</div>
                    <div class="mb-3">{{ form_row(form.lon) }}</div>
                </fieldset>
                <button class="btn btn-primary" type="submit">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}