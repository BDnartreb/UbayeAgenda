{% extends 'front.html.twig' %}

{% block title %}Organisation Name{% endblock %}

{% block content %}

<div class="main-container">
    <div class="left-container">
        <div class="">
            <h1>{{ organisation.name }}</h1>
            <p>{{ organisation.address }}, {{ organisation.town.value }}</p>
            <p>{{ organisation.email }}</p>
            <p>{{ organisation.phone }}</p>
            <p>{{ organisation.status.value }}</p>
            <h3>Référent :</h3>
            <p>{{ organisation.firstName }} {{ organisation.lastName }}</p>
        </div>
        <div class="left-container-btn">
            <div>
                <a href="{{ path('organisation_update', {'id': organisation.id}) }}" class="btn-link btn-link-modify">Modifier</a>
            </div>
            {% if is_granted('ROLE_ORGANISATION') and not is_granted('ROLE_ADMIN') %}
            <div>
                <form method="post" action="{{ path('organisation_delete', {'id': organisation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le compte de votre organisation et les événements associés ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ organisation.id) }}">
                    <button class="btn-link btn-link-delete">Supprimer</button>
                </form>
            </div>
            {% endif %}
        </div>
        <div><br><h3>Filtrer par :</h3></div>
        <form id="filters-form" method="get" action="{{ path('organisation') }}">
            {% set today = 'now'|date('Y-m-d') %}
            <div class="filter-group">
                <input 
                    type="checkbox" 
                    id="toggle-date" 
                    hidden
                    {% if selectedDate != today %}checked{% endif %}
                >

                <label for="toggle-date" class="filter-title">Date</label>

                <div class="filter-options">
                    <input 
                        type="date"
                        id="selectedDate"
                        name="selectedDate"
                        value="{{ selectedDate }}"
                    >
                </div>
            </div>
            <button type="submit" class="btn-link btn-link-modify">Filtrer</button>
        </form>
  
    </div>
    <div class="central-container">
        {% for event in events %}
            <div class="item-container"> 
                <a href="{{ path('event', {'id': event.id}) }}">
                    <div class="event-small-card">
                        {% if event.poster is not null %}
                            <div class="event-poster">
                                <img src="{{ asset(event.poster) }}" alt="Affiche de l'événement">
                            </div>
                        {% endif %}
                        <div class="event-small-card-data">
                            <div class=""><h2> {{ event.name }} </h2></div>
                            <div class=""><h4>{{ event.startDate|date('l d/m/Y - H:i')  }} à {{ event.endDate|date('H:i') }}</h4></div>
                            <div class=""><h4>{{ event.location.name }} - {{ event.location.town.value }}</h4></div>
                            <div class=""><h5>{{ event.thematic.value }} - {{ event.fee.value }} - Public : {{ event.public.value }}</h5></div>
                        </div>
                    </div>
                </a>
                
                <div class="btn-container">
                    <div>
                        <a href="{{ path('organisation_event_update', {'id': event.id}) }}" class="btn-link btn-link-modify">Modifier</a>
                    </div>
                    <div>
                        <form method="post" action="{{ path('organisation_event_delete', {'id': event.id}) }}" style="display:inline;" onsubmit="return confirm('Voulez-vous vraiment supprimer cet événement ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                            <button type="submit" class="btn-link btn-link-delete">Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div> 



</div>
{% endblock %}
