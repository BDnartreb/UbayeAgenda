{% extends 'front.html.twig' %}

{% block title %}Organisation Name{% endblock %}

{% block content %}

<div class="main-container">
    <div class="event-description-container">
        <div class="poster-big-format">
            <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
        </div>
        <div class="event-description-card">
                <div class="description-card-name"><h1>{{ organisation.name }}</h1></div>

        </div>
        <div class="day-container">
                {% for event in events %}
                <div class="day">
                    <div class="day-before"><h1><i class="fa-solid fa-caret-left"></i></h1></div>
                    <div class="event_name"><h1> {{ event.name }} </h1></div>
                    <div class="day-after"><h1><i class="fa-solid fa-caret-right"></i></h1></div>
                </div>
                {% endfor %}
                <div class="events">
                    <div class="event-card">
                        <div class="event-poster">
                            <img src="{{ asset('images/poster.jpg') }}" alt="Affiche de l'événement">
                        </div>
                        <div class="event-info">
                            <div class="event-time-location"><h2>11h30 - Lieu de l'Event</h2></div>
                            <div class="event-name"><h2>Event Name</h2></div>
                            <div class="event-organizer"><h3>Présenté par : Organisateur Name</h3></div>
                            <div class="event-moreinfo"><h4>Spectacle - Gratuit - Tout public</h4></div>
                        </div>
                    </div>
                </div>
            </div> 
        {# <form method="post" action="{{ path('orga_delete', { id: organisation.id }) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette organisation ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ organisation.id) }}"> #}
            <form method="post" action="{{ path('orga_delete') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le compte de votre organisation et les événements associés ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ organisation.id) }}">

    <button class="btn btn-danger">Supprimer le compte</button>
</form>


    </div>
</div>
{% endblock %}
